APP_NAME=Z-Syst
APP_ENV=production
APP_KEY=generate-secure-app-key-here
APP_DEBUG=false
APP_URL=https://your-production-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=your-production-host
DB_PORT=3306
DB_DATABASE=z_syst_production
DB_USERNAME=production_user
DB_PASSWORD=secure-password-here

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=secure-redis-password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your-s3-bucket
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=

PUSHER_APP_ID=your-pusher-app-id
PUSHER_APP_KEY=your-pusher-app-key
PUSHER_APP_SECRET=your-pusher-app-secret
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=z-syst
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-sender-id
VITE_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

INSTALLER_HEADER_KEYS=
INSTALLER_API_URL="https://api.envato.com"
INSTALLER_DOWNLOAD_PATH="/../../../../.."

PHONEPE_MERCHANT_ID=your-phonepe-merchant-id
PHONEPE_MERCHANT_USER_ID=your-phonepe-user-id
PHONEPE_ENV=production
PHONEPE_SALT_KEY=your-phonepe-salt-key
PHONEPE_SALT_INDEX="1"
PHONEPE_REDIRECT_URL=phonepe/status
PHONEPE_CALLBACK_URL=phonepe/status

# SaaS Specific Settings
SAAS_ENABLED=true
SAAS_MAX_TENANTS=1000
SAAS_DEFAULT_PLAN_ID=1
SAAS_TRIAL_DAYS=14

# Security Settings
FORCE_HTTPS=true
SESSION_SECURE_COOKIE=true
ALLOWED_ORIGINS="https://your-domain.com,https://www.your-domain.com"
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ATTEMPTS=60
RATE_LIMIT_DECAY_MINUTES=1

# Backup Settings
BACKUP_ENABLED=true
BACKUP_DISK=s3
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Monitoring & Performance
SENTRY_DSN=your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-newrelic-license
ENABLE_QUERY_LOG=false
SLOW_QUERY_THRESHOLD_MS=1000

# CDN Settings
CDN_URL=https://cdn.your-domain.com
ASSET_URL=https://cdn.your-domain.com

# HTTPS/SSL
HTTPS_FORCE_REDIRECT=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# Egyptian Payment Gateways Configuration
VODAFONE_CASH_MERCHANT_ID=your-vodafone-merchant-id
VODAFONE_CASH_API_KEY=your-vodafone-api-key
VODAFONE_CASH_API_SECRET=your-vodafone-api-secret
VODAFONE_CASH_ENVIRONMENT=production

BANK_CARD_MERCHANT_ID=your-bank-card-merchant-id
BANK_CARD_API_KEY=your-bank-card-api-key
BANK_CARD_API_SECRET=your-bank-card-api-secret
BANK_CARD_ENVIRONMENT=production
BANK_CARD_ACCEPT_MEEZA=false
BANK_CARD_ACCEPT_VISAMASTERCARD=true

FAWRY_MERCHANT_CODE=your-fawry-merchant-code
FAWRY_SECURITY_KEY=your-fawry-security-key
FAWRY_ENVIRONMENT=production

ORANGE_CASH_MERCHANT_ID=your-orange-merchant-id
ORANGE_CASH_API_KEY=your-orange-api-key
ORANGE_CASH_API_SECRET=your-orange-api-secret
ORANGE_CASH_ENVIRONMENT=production

INSTAPAY_MERCHANT_ID=your-instapay-merchant-id
INSTAPAY_API_KEY=your-instapay-api-key
INSTAPAY_API_SECRET=your-instapay-api-secret
INSTAPAY_ENVIRONMENT=production

CASH_REQUIRE_VERIFICATION=true
CASH_ALLOW_PARTIAL_PAYMENT=false
CASH_AUTO_COMPLETE=true

# Rate Limiting Settings
PAYMENT_RATE_LIMIT=10,1
API_RATE_LIMIT=60,1
AUTH_RATE_LIMIT=5,1

# Supabase Configuration (Optional)
SUPABASE_URL=your-supabase-project-url
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_HOST=your-supabase-db-host
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=your-database-name
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=your-database-password
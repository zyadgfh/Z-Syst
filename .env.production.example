APP_NAME="Z-Syst Pharmacy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://z-syst-api.onrender.com
CORS_ALLOWED_ORIGINS="https://app.z-syst.com"
CORS_ALLOWED_ORIGINS_PATTERNS=""
CORS_SUPPORTS_CREDENTIALS=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.atvttthrqsybjjwrbiyl
DB_PASSWORD=

BROADCAST_DRIVER=log

# Session, cache and queue live in Postgres, not on the container filesystem.
# All the tables already exist in production with exactly the shape and indexes
# Laravel's drivers expect (cache + cache_locks, sessions, jobs + failed_jobs),
# so this needs no new dependency and no schema change. Leaving them on `file`
# meant every deploy logged users out, discarded the cache, and pinned the app
# to a single instance — see RUNBOOK §7.
CACHE_DRIVER=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
SESSION_LIFETIME=120

# Uploads are the one thing still on local disk: FILESYSTEM_DISK=s3 needs
# league/flysystem-aws-s3-v3, which is not in composer.json. Until that lands,
# render.yaml mounts a persistent disk at storage/ so uploads survive deploys —
# and a Render disk is attached to a single instance, so do not scale the web
# service horizontally while it is mounted.
FILESYSTEM_DISK=local

# Redis / Valkey. Not usable as a driver yet: composer.lock has no
# predis/predis, and the redis PHP extension only exists in the Docker image
# (Dockerfile). Once REDIS_HOST points at a real instance, switching the three
# drivers above to `redis` is configuration, not code. The `redis` driver works
# unchanged with Valkey (drop-in replacement — docs/valkey-setup-ar.md,
# docker-compose.valkey.yml).
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Security Settings
SECURITY_ENABLED=true
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION=15

# Backup Settings
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"

# Performance Settings
CACHE_TTL=3600
ENABLE_QUERY_LOGGING=false
ENABLE_CACHE=true

# SaaS Settings
SAAS_ENABLED=true
SAAS_TRIAL_DAYS=14
SAAS_MAX_TENANTS=1000

# Supabase (Path B)
SUPABASE_URL=https://atvttthrqsybjjwrbiyl.supabase.co
SUPABASE_ANON_KEY=<<<NEEDED:SUPABASE_ANON_KEY>>>
SUPABASE_JWT_SECRET=<<<NEEDED:SUPABASE_JWT_SECRET>>>
SUPABASE_JWT_ISSUER="https://atvttthrqsybjjwrbiyl.supabase.co/auth/v1"
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_LEEWAY=10
SUPABASE_ENFORCE_RLS=true

# CAPTCHA (hCaptcha) — enable only in lock-step with the Supabase project
SUPABASE_CAPTCHA_ENABLED=false
SUPABASE_CAPTCHA_PROVIDER=hcaptcha
HCAPTCHA_SITE_KEY=<<<NEEDED:HCAPTCHA_SITE_KEY>>>

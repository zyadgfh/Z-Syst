APP_NAME="Z-Syst Pharmacy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://z-syst-api.onrender.com
CORS_ALLOWED_ORIGINS="https://app.z-syst.com"
CORS_ALLOWED_ORIGINS_PATTERNS=""
CORS_SUPPORTS_CREDENTIALS=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.atvttthrqsybjjwrbiyl
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Works with Redis OR Valkey (drop-in replacement — docs/valkey-setup-ar.md).
# Set a real REDIS_PASSWORD when using docker-compose.valkey.yml.
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Security Settings
SECURITY_ENABLED=true
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION=15

# Backup Settings
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"

# Performance Settings
CACHE_TTL=3600
ENABLE_QUERY_LOGGING=false
ENABLE_CACHE=true

# SaaS Settings
SAAS_ENABLED=true
SAAS_TRIAL_DAYS=14
SAAS_MAX_TENANTS=1000

# Supabase (Path B)
SUPABASE_URL=https://atvttthrqsybjjwrbiyl.supabase.co
SUPABASE_ANON_KEY=<<<NEEDED:SUPABASE_ANON_KEY>>>
SUPABASE_JWT_SECRET=<<<NEEDED:SUPABASE_JWT_SECRET>>>
SUPABASE_JWT_ISSUER="https://atvttthrqsybjjwrbiyl.supabase.co/auth/v1"
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_LEEWAY=10
SUPABASE_ENFORCE_RLS=true

# CAPTCHA (hCaptcha) — enable only in lock-step with the Supabase project
SUPABASE_CAPTCHA_ENABLED=false
SUPABASE_CAPTCHA_PROVIDER=hcaptcha
HCAPTCHA_SITE_KEY=<<<NEEDED:HCAPTCHA_SITE_KEY>>>

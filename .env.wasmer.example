# ---------------------------------------------------------------------------
# Z-Syst — environment for a Wasmer Edge deployment of the Laravel app.
#
# How to use:
#   1. On https://wasmer.io/apps/create?github=... (Import from Git) expand
#      "Environment variables" and paste this file's contents into the
#      "Paste a .env above to populate the form" box.
#   2. Replace every <PLACEHOLDER> before pasting. Never commit real secrets.
#   3. Anything you paste here ends up as app config in Wasmer; rotate secrets
#      from the app dashboard (Settings -> Secrets) afterwards if needed.
#
# Read docs/deploy-wasmer.md first — Wasmer Edge has a read-only package
# filesystem, so the drivers below are deliberately file-free.
# ---------------------------------------------------------------------------

APP_NAME="Z-Syst"
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show
APP_KEY=
# Drop the trailing slash; use the URL Wasmer prints after the first deploy.
APP_URL=https://<app-name>.<owner>.wasmer.app

# Wasmer's package filesystem is read-only (only volumes are writable).
# errorlog -> php://stderr (see config/logging.php), so no storage/logs write.
LOG_CHANNEL=errorlog
LOG_LEVEL=warning

# Sessions must not live on the filesystem: use the `sessions` table
# (database/migrations/2026_11_02_000001_create_sessions_table.php).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# No `cache` table migration exists in this repo, so database/file/redis cache
# would fail. `array` is per-instance and fine for read-mostly traffic.
CACHE_DRIVER=array

# Jobs still queue in Postgres; nothing drains them on Wasmer (see doc).
QUEUE_CONNECTION=database
BROADCAST_DRIVER=log

# Compiled Blade views + any local storage writes go to the volume mounted at
# /app/storage (app.yaml -> volumes). Create the directories once over SFTP.
VIEW_COMPILED_PATH=/app/storage/framework/views

CORS_ALLOWED_ORIGINS="https://app.z-syst.com"
CORS_ALLOWED_ORIGINS_PATTERNS=""
CORS_SUPPORTS_CREDENTIALS=false

SMS_DRIVER=log

# --- Database: existing Supabase project (recommended) ----------------------
# Port 5432 = session pooler (prepared statements OK), 6543 = transaction
# pooler (more connections, no server-side prepares).
DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.atvttthrqsybjjwrbiyl
DB_PASSWORD=<SUPABASE_DB_PASSWORD>
DB_SSLMODE=require

# Alternative: let Wasmer provision Postgres instead. Turn on "Enable
# Database" and pick PostgreSQL; Wasmer injects DB_HOST/DB_PORT/DB_NAME/
# DB_USERNAME/DB_PASSWORD. config/database.php now reads DB_NAME when
# DB_DATABASE is unset, and Wasmer databases require TLS, so also set:
#   DB_CONNECTION=pgsql
#   DB_SSLMODE=require

# --- Supabase (Path B: GoTrue auth + RLS) -----------------------------------
SUPABASE_URL=https://atvttthrqsybjjwrbiyl.supabase.co
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_JWT_SECRET=<SUPABASE_JWT_SECRET>
SUPABASE_JWT_ISSUER="https://atvttthrqsybjjwrbiyl.supabase.co/auth/v1"
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_LEEWAY=10
SUPABASE_ENFORCE_RLS=true

SUPABASE_CAPTCHA_ENABLED=false
SUPABASE_CAPTCHA_PROVIDER=hcaptcha
HCAPTCHA_SITE_KEY=<HCAPTCHA_SITE_KEY>

# --- Object storage ---------------------------------------------------------
# Local uploads do not survive a redeploy on Wasmer; keep S3/Supabase Storage.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=<S3_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<S3_SECRET_ACCESS_KEY>
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=<S3_BUCKET>
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail / analytics (optional) -------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<MAIL_USERNAME>
MAIL_PASSWORD=<MAIL_PASSWORD>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

OPENPANEL_ENABLED=false
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=
OPENPANEL_API_URL=https://api.openpanel.dev

# ---- Laravel core ----
/node_modules
/public/build
# Vercel SPA build output (vite.config.vercel.js writes here); built on deploy.
/dist
/public/hot
/vendor
npm-debug.log
yarn-error.log
yarn.lock
package-lock.json.bak

# ---- Environment files: only tracked *example*/testing templates allowed ----
.env
.env.*
!.env.example
!.env.production.example
!.env.testing

# ---- Caches & test artifacts ----
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache
/.idea
/.vscode
*.swp

# ---- Deploys / installer state ----
Homestead.json
Homestead.yaml
auth.json
/storage/app/public
/storage/app/temp
/storage/app/uploads
/storage/debugbar
/storage/installed

# ---- One-off dumps & scratch (never commit these again) ----
/database/database_export.sql
/database/export_*.php
routes.txt
temp_*.html

# ---- User uploads belong on object storage (Supabase Storage / S3) ----
# Runtime artifacts, not source. They used to be tracked; they are not any
# more: this repository is public and uploads can carry prescriptions and
# other tenant/patient data. Verified safe to untrack on 2026-11-13 — every
# text/json/jsonb column of every public table in production was scanned and
# no row references uploads/ or demo_images, and no Blade view or built asset
# references either directory. New uploads stay out of Git; a deploy image no
# longer carries the old ones.
/public/uploads
/public/demo_images

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
desktop.ini

# Python bytecode (tools/*.py)
__pycache__/
*.pyc

# agent scratch space (never committed)
/.scratch/

# code-vulnscan local scan state (SQLite, regenerated per run)
.github/skills/code-vulnscan/workspace/

# ---- Laravel core ----
/node_modules
/public/build
/public/hot
/vendor
npm-debug.log
yarn-error.log
yarn.lock
package-lock.json.bak

# ---- Environment files: only tracked *example*/testing templates allowed ----
.env
.env.*
!.env.example
!.env.production.example
!.env.testing

# ---- Caches & test artifacts ----
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache
/.idea
/.vscode
*.swp

# ---- Deploys / installer state ----
Homestead.json
Homestead.yaml
auth.json
/storage/app/public
/storage/app/temp
/storage/app/uploads
/storage/debugbar
/storage/installed

# ---- One-off dumps & scratch (never commit these again) ----
/database/database_export.sql
/database/export_*.php
routes.txt
temp_*.html

# ---- User uploads belong on object storage (Supabase Storage / S3) ----
# Existing tracked files are intentionally kept until migrated; new ones stay out.
/public/uploads

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
desktop.ini

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  role      Role
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  branch    Branch?    @relation(fields: [branchId], references: [id])
  branchId  Int?
  cartItems CartItem[]
  sales     Sale[]
}

enum Role {
  ADMIN
  PHARMACIST
  MANAGER
  STAFF
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  users     User[]
  stocks    Stock[]
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          Int        @id @default(autoincrement())
  sku         String     @unique
  name        String
  description String?
  price       Decimal
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  stocks      Stock[]
  sales       SaleItem[]
  cartItems   CartItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int
  price     Decimal
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Stock {
  id          Int       @id @default(autoincrement())
  product     Product   @relation(fields: [productId], references: [id])
  productId   Int
  branch      Branch    @relation(fields: [branchId], references: [id])
  branchId    Int
  quantity    Int
  batchNumber String?
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Sale {
  id          Int        @id @default(autoincrement())
  branch      Branch     @relation(fields: [branchId], references: [id])
  branchId    Int
  user        User?      @relation(fields: [userId], references: [id])
  userId      Int?
  totalAmount Decimal    @default(0)
  status      String     @default("PENDING")
  createdAt   DateTime   @default(now())
  items       SaleItem[]
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  sale      Sale    @relation(fields: [saleId], references: [id])
  saleId    Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int
  price     Decimal
}

model Patient {
  id            Int            @id @default(autoincrement())
  name          String
  phoneNumber   String?
  email         String?
  allergies     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  prescriptions Prescription[]
}

model Prescription {
  id        Int      @id @default(autoincrement())
  patient   Patient  @relation(fields: [patientId], references: [id])
  patientId Int
  imageUrl  String?
  createdAt DateTime @default(now())
  processed Boolean  @default(false)
}

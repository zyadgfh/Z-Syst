rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Locked: Supabase is the single source of truth.
    // Firestore is deny-all. If FCM token storage is needed later,
    // add a single narrowly-scoped path with Custom-Claim checks.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

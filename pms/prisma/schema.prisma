// Pharmacy Management System - Prisma Schema
// PostgreSQL for structured data (financial & inventory)
// MongoDB for unstructured data (patient records & prescriptions)

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiCompositeUnique", "filteredRelationCount"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

/////////////////////
// CORE MODELS
/////////////////////

model Company {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  email           String?
  phone           String?
  address         String?
  logo            String?
  taxNumber       String?
  settings        Json?
  subscriptionId  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  branches        Branch[]
  users           User[]
  products        Product[]
  suppliers       Supplier[]
  customers       Customer[]
  insuranceCompanies InsuranceCompany[]
  
  @@map("companies")
}

model Branch {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  slug        String
  code        String   @unique
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  company     Company  @relation(fields: [companyId], references: [id])
  users       User[]
  inventory   Inventory[]
  sales       Sale[]
  stockTransfers StockTransfer[] @relation("FromBranch")
  stockTransfersTo StockTransfer[] @relation("ToBranch")
  
  @@map("branches")
}

model User {
  id              String    @id @default(cuid())
  companyId       String?
  branchId        String?
  name            String
  email           String    @unique
  emailVerified   DateTime?
  phone           String?
  password        String?
  avatar          String?
  role            UserRole  @default(PHARMACIST)
  isActive        Boolean   @default(true)
  twoFactorSecret String?
  twoFactorEnabled Boolean  @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  company         Company?  @relation(fields: [companyId], references: [id])
  branch          Branch?   @relation(fields: [branchId], references: [id])
  sales           Sale[]
  stockMovements  StockMovement[]
  
  @@map("users")
}

enum UserRole {
  ADMIN
  PHARMACIST
  CASHIER
  MANAGER
  DELIVERY
  DOCTOR
}

/////////////////////
// PRODUCT MODELS
/////////////////////

model Category {
  id          String    @id @default(cuid())
  companyId   String?
  name        String
  slug        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  company     Company?  @relation(fields: [companyId], references: [id])
  products    Product[]
  
  @@map("categories")
}

model Manufacturer {
  id          String    @id @default(cuid())
  companyId   String?
  name        String
  slug        String
  contact     String?
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  company     Company?  @relation(fields: [companyId], references: [id])
  products    Product[]
  
  @@map("manufacturers")
}

model Product {
  id               String    @id @default(cuid())
  companyId        String
  categoryId       String?
  manufacturerId   String?
  name             String
  slug             String
  barcode          String?
  sku              String?   @unique
  description      String?
  activeIngredient String?
  strength         String?
  unit             String?
  purchasePrice    Decimal   @default(0) @db.Decimal(10, 2)
  sellingPrice     Decimal   @default(0) @db.Decimal(10, 2)
  discountPercent  Decimal   @default(0) @db.Decimal(5, 2)
  stockAlertLevel  Int       @default(0)
  isControlled     Boolean   @default(false)
  controlledClass  String?
  isActive         Boolean   @default(true)
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  company          Company   @relation(fields: [companyId], references: [id])
  category         Category? @relation(fields: [categoryId], references: [id])
  manufacturer     Manufacturer? @relation(fields: [manufacturerId], references: [id])
  inventory        Inventory[]
  saleItems        SaleItem[]
  stockMovements   StockMovement[]
  interactionsAsDrugA DrugInteraction[] @relation("DrugA")
  interactionsAsDrugB DrugInteraction[] @relation("DrugB")
  
  @@index([companyId, name])
  @@index([barcode])
  @@map("products")
}

model DrugInteraction {
  id        String   @id @default(cuid())
  drugAId   String
  drugBId   String
  severity  InteractionSeverity @default(MODERATE)
  description String?
  createdAt DateTime @default(now())
  
  drugA     Product  @relation("DrugA", fields: [drugAId], references: [id])
  drugB     Product  @relation("DrugB", fields: [drugBId], references: [id])
  
  @@unique([drugAId, drugBId])
  @@map("drug_interactions")
}

enum InteractionSeverity {
  MILD
  MODERATE
  SEVERE
}

/////////////////////
// INVENTORY MODELS
/////////////////////

model Inventory {
  id            String    @id @default(cuid())
  productId     String
  branchId      String
  batchNumber   String?
  expiryDate    DateTime?
  quantity      Int       @default(0)
  reservedQty   Int       @default(0)
  purchasePrice Decimal   @db.Decimal(10, 2)
  sellingPrice  Decimal   @db.Decimal(10, 2)
  location      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  product       Product   @relation(fields: [productId], references: [id])
  branch        Branch    @relation(fields: [branchId], references: [id])
  
  @@unique([productId, branchId, batchNumber])
  @@index([expiryDate])
  @@index([branchId, productId])
  @@map("inventory")
}

model StockMovement {
  id          String        @id @default(cuid())
  productId   String
  branchId    String
  type        MovementType
  quantity    Int
  referenceId String?
  notes       String?
  userId      String?
  createdAt   DateTime      @default(now())
  
  product     Product       @relation(fields: [productId], references: [id])
  branch      Branch        @relation(fields: [branchId], references: [id])
  user        User?         @relation(fields: [userId], references: [id])
  
  @@index([productId, branchId, createdAt])
  @@map("stock_movements")
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER
  RETURN
  EXPIRED
  DAMAGED
}

model StockAdjustment {
  id          String              @id @default(cuid())
  branchId    String
  userId      String
  type        AdjustmentType
  notes       String?
  status      AdjustmentStatus    @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  
  branch      Branch              @relation(fields: [branchId], references: [id])
  items       StockAdjustmentItem[]
  
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id             String   @id @default(cuid())
  stockAdjustmentId String
  productId      String
  batchNumber    String?
  quantityBefore Int
  quantityAfter  Int
  reason         String?
  
  stockAdjustment StockAdjustment @relation(fields: [stockAdjustmentId], references: [id])
  
  @@map("stock_adjustment_items")
}

enum AdjustmentType {
  ADDITION
  SUBTRACTION
  RECONCILIATION
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

/////////////////////
// SALES & POS MODELS
/////////////////////

model Sale {
  id              String          @id @default(cuid())
  companyId       String
  branchId        String
  customerId      String?
  userId          String
  invoiceNumber   String          @unique
  totalAmount     Decimal         @db.Decimal(10, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal         @default(0) @db.Decimal(10, 2)
  finalAmount     Decimal         @db.Decimal(10, 2)
  paidAmount      Decimal         @default(0) @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  status          SaleStatus      @default(COMPLETED)
  notes           String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  company         Company         @relation(fields: [companyId], references: [id])
  branch          Branch          @relation(fields: [branchId], references: [id])
  customer        Customer?       @relation(fields: [customerId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  items           SaleItem[]
  payments        SalePayment[]
  
  @@index([branchId, createdAt])
  @@index([invoiceNumber])
  @@map("sales")
}

model SaleItem {
  id          String    @id @default(cuid())
  saleId      String
  productId   String
  quantity    Int
  unitPrice   Decimal   @db.Decimal(10, 2)
  discount    Decimal   @default(0) @db.Decimal(10, 2)
  totalPrice  Decimal   @db.Decimal(10, 2)
  batchNumber String?
  
  sale        Sale      @relation(fields: [saleId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  
  @@map("sale_items")
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
  INSURANCE
  CREDIT
}

enum SaleStatus {
  COMPLETED
  PENDING
  CANCELLED
  RETURNED
}

model SalePayment {
  id          String    @id @default(cuid())
  saleId      String
  method      PaymentMethod
  amount      Decimal   @db.Decimal(10, 2)
  reference   String?
  createdAt   DateTime  @default(now())
  
  sale        Sale      @relation(fields: [saleId], references: [id])
  
  @@map("sale_payments")
}

/////////////////////
// CUSTOMER & PATIENT MODELS
/////////////////////

model Customer {
  id              String    @id @default(cuid())
  companyId       String?
  name            String
  email           String?
  phone           String?
  dateOfBirth     DateTime?
  gender          String?
  address         String?
  allergies       String?
  chronicDiseases String?
  loyaltyPoints   Int       @default(0)
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  company         Company?  @relation(fields: [companyId], references: [id])
  sales           Sale[]
  
  @@map("customers")
}

model Supplier {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  email       String?
  phone       String?
  address     String?
  contactPerson String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  company     Company   @relation(fields: [companyId], references: [id])
  
  @@map("suppliers")
}

/////////////////////
// PRESCRIPTION MODELS
/////////////////////

model Prescription {
  id              String    @id @default(cuid())
  companyId       String
  customerId      String?
  doctorId      String?
  prescriptionNumber String @unique
  notes           String?
  status          PrescriptionStatus @default(PENDING)
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  company         Company   @relation(fields: [companyId], references: [id])
  customer        Customer? @relation(fields: [customerId], references: [id])
  doctor          Doctor?   @relation(fields: [doctorId], references: [id])
  items           PrescriptionItem[]
  
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String    @id @default(cuid())
  prescriptionId String
  productId      String
  quantity       Int
  dosage         String?
  frequency      String?
  duration       String?
  notes          String?
  
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  
  @@map("prescription_items")
}

enum PrescriptionStatus {
  PENDING
  FILLED
  CANCELLED
  EXPIRED
}

model Doctor {
  id          String    @id @default(cuid())
  companyId   String?
  name        String
  license     String?
  specialization String?
  email       String?
  phone       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  company     Company?  @relation(fields: [companyId], references: [id])
  
  @@map("doctors")
}

/////////////////////
// INSURANCE MODELS
/////////////////////

model InsuranceCompany {
  id          String    @id @default(cuid())
  companyId   String?
  name        String
  code        String?
  contact     String?
  email       String?
  apiEndpoint String?
  settings    Json?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  company     Company?  @relation(fields: [companyId], references: [id])
  
  @@map("insurance_companies")
}

model InsuranceClaim {
  id              String    @id @default(cuid())
  companyId       String
  saleId          String
  insuranceCompanyId String
  claimNumber     String    @unique
  status          ClaimStatus @default(PENDING)
  amount          Decimal   @db.Decimal(10, 2)
  approvedAmount  Decimal?  @db.Decimal(10, 2)
  rejectionReason String?
  submittedAt     DateTime?
  processedAt     DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  company         Company   @relation(fields: [companyId], references: [id])
  sale            Sale      @relation(fields: [saleId], references: [id])
  insuranceCompany InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  
  @@map("insurance_claims")
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/////////////////////
// ANALYTICS MODELS
/////////////////////

model Forecast {
  id              String    @id @default(cuid())
  productId       String
  branchId        String
  forecastDate    DateTime
  predictedQty    Int
  confidenceScore Float?
  factors         Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([productId, forecastDate])
  @@map("forecasts")
}

model LoyaltyTransaction {
  id          String    @id @default(cuid())
  customerId  String
  points      Int
  type        LoyaltyType
  reference   String?
  createdAt   DateTime  @default(now())
  
  @@map("loyalty_transactions")
}

enum LoyaltyType {
  EARNED
  REDEEMED
}

/////////////////////
// WHATSAPP INTEGRATION
/////////////////////

model WhatsAppSession {
  id          String    @id @default(cuid())
  customerId  String
  phoneNumber String
  sessionId   String    @unique
  status      SessionStatus @default(ACTIVE)
  messages    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@map("whatsapp_sessions")
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  CLOSED
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id               Int        @id @default(autoincrement())
  sku              String     @unique
  name             String
  activeIngredient String?
  category         String
  price            Float
  createdAt        DateTime   @default(now())
  inventory        Inventory?
}

model Inventory {
  id           Int       @id @default(autoincrement())
  productId    Int       @unique
  quantity     Int       @default(0)
  reorderLevel Int       @default(10)
  batchNumber  String?
  expiryDate   DateTime?
  location     String?
  product      Product   @relation(fields: [productId], references: [id])
}

model Patient {
  id        Int       @id @default(autoincrement())
  fullName  String
  dob       DateTime?
  allergies String?
}

model Sale {
  id        Int        @id @default(autoincrement())
  patientId Int?
  total     Float
  createdAt DateTime   @default(now())
  items     SaleItem[]
}

model SaleItem {
  id        Int   @id @default(autoincrement())
  saleId    Int
  productId Int
  qty       Int
  price     Float
  sale      Sale  @relation(fields: [saleId], references: [id])
}

model PurchaseOrder {
  id        Int      @id @default(autoincrement())
  productId Int
  qty       Int
  supplier  String?
  createdAt DateTime @default(now())
  status    String   @default("pending")
}

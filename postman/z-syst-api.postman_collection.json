        {
          "name": "Product Batches",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/fefo/product-batches/1", "host": ["{{baseUrl}}"], "path": ["fefo", "product-batches", "1"] },
            "description": "Get batches for a specific product."
          }
        },
        {
          "name": "Batch Suggestions",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/fefo/suggestions/1", "host": ["{{baseUrl}}"], "path": ["fefo", "suggestions", "1"] },

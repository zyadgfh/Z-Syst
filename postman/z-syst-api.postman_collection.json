          }
        },
        {
          "name": "Sale Suggestions",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/fefo/sale-suggestions", "host": ["{{baseUrl}}"], "path": ["fefo", "sale-suggestions"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 5\n}" },

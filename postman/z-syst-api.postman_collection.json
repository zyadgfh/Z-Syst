        },
        {
          "name": "Party Balance",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/loyalty/balance/1", "host": ["{{baseUrl}}"], "path": ["loyalty", "balance", "1"] },
            "description": "Get loyalty points balance for a customer."
          }
        },
        {
          "name": "Party History",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/loyalty/history/1", "host": ["{{baseUrl}}"], "path": ["loyalty", "history", "1"] },
            "description": "Get loyalty points history for a customer."

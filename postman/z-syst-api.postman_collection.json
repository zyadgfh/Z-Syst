          }
        },
        {
          "name": "Remove Expired",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/fefo/remove-expired", "host": ["{{baseUrl}}"], "path": ["fefo", "remove-expired"] },
            "description": "Remove all expired batches from active stock."
          }
        },
        {
          "name": "FEFO Logs",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/fefo/logs", "host": ["{{baseUrl}}"], "path": ["fefo", "logs"] },
            "description": "Get FEFO dispensing activity logs."
          }
        }
      ]
    },
    {
      "name": "Loyalty Programs",

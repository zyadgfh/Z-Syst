            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"enabled\": true,\n  \"expiry_warning_days\": 30,\n  \"auto_remove_expired\": false\n}" },
            "description": "Update FEFO configuration."

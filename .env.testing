APP_NAME=Z-Syst
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
# Must include a scheme. Laravel replaces .env with this file whenever
# APP_ENV=testing (LoadEnvironmentVariables::checkForSpecificEnvironmentFile),
# and the test client builds every request URI from APP_URL. Written bare as
# "z-syst.wasmer.app" it produced a malformed URL, no route matched, and all 289
# HTTP tests in the suite returned 404.
APP_URL=https://z-syst.wasmer.app

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

MAIL_MAILER=array
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

TELESCOPE_ENABLED=false
